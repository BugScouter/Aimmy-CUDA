<Window x:Class="Visuality.DetectedPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Visuality"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        Focusable="False"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        ResizeMode="NoResize"
        IsTabStop="False">
    <Grid>
        <Label x:Name="DetectedPlayerConfidence"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               FontFamily="Consolas"
               Content="Confidence = 20%"
               Padding="0,0,0,0"
               Opacity="0"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"
               Foreground="#DDFF0000"
               FontSize="20" />
        <Border x:Name="DetectedPlayerFocus"
                Width="50"
                Height="50"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Visible"
                Opacity="0" />
        <Border x:Name="DebugOverlay"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10,10,0,0"
                Padding="10"
                Background="#88000000"
                CornerRadius="5"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="DEBUG OVERLAY" Foreground="Cyan" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,0,0,5">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtAILoop" Text="AILoop: 0.00ms" Foreground="LimeGreen" FontFamily="Consolas" FontSize="12">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtScreenGrab" Text="ScreenGrab: 0.00ms" Foreground="LimeGreen" FontFamily="Consolas" FontSize="12">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtNormalization" Text="Normalization: 0.00ms" Foreground="LimeGreen" FontFamily="Consolas" FontSize="12">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtInference" Text="Inference: 0.00ms" Foreground="LimeGreen" FontFamily="Consolas" FontSize="12">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtKDTree" Text="KDTree: 0.00ms" Foreground="LimeGreen" FontFamily="Consolas" FontSize="12">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtHandleAim" Text="HandleAim: 0.00ms" Foreground="LimeGreen" FontFamily="Consolas" FontSize="12">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Separator Background="DimGray" Margin="0,5"/>
                <TextBlock x:Name="TxtFPS" Text="Overall FPS: 0.00" Foreground="Cyan" FontFamily="Consolas" FontSize="12" FontWeight="Bold">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>
        <Line x:Name="DetectedTracers"
              X1="0"
              Y1="0"
              X2="10"
              Y2="10"
              Stroke="Red"
              Opacity="0">
        </Line>
    </Grid>
</Window>